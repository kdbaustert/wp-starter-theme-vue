{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/latest-posts",
  "title": "Latest posts",
  "category": "widgets",
  "icon": "admin-post",
  "description": "The newest posts as a row of cards.",
  "textdomain": "sage",
  "attributes": {
    "postsToShow": {
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "default": 3
    },
    "columns": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "default": 3
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  }
}
